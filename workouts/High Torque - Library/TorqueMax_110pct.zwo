<!--
  High Torque Training — Zwift workout
  Last updated: 2026-11-11

  Site:      https://high-torque.jelen.dk/
  Calendar:  https://high-torque.jelen.dk/content/workouts.md
  Rationale: https://high-torque.jelen.dk/content/rationale.md
  LLMs:      https://high-torque.jelen.dk/llms.txt
-->
<workout_file>
    <author>Tom Jelen</author>
    <name>TorqueMax</name>
    <activitySaveName>High Torque: TorqueMax 6x2.5 min 105-110% FTP @ 50-60 rpm</activitySaveName>
    <description>EVOQ.BIKE's TorqueMax session (Landry Bobo, EVOQ blog, 2026): "around 2-3 minutes at 105-110% of FTP and around 50-60 rpm", "starting with six repetitions and working up to eight". The workout: six 2.5-minute intervals at 110% FTP (the top of EVOQ's range) and 55 rpm, with 4 minutes of easy spin between them. 2.5 min and 110% are my picks inside EVOQ's range; EVOQ gives no recovery, so the 4 minutes are mine. EVOQ warns: "There is an increased risk of injury with these intervals", so do the lower-intensity torque intervals first. TorqueMax is EVOQ's extension of the Hebisz 2024 study to a new format; no study has tested it. The two short openers (30 s at normal cadence) are my addition, not from EVOQ. Seated throughout.</description>
    <sportType>bike</sportType>
    <tags />
    <workout>
        <Warmup Duration="900" PowerLow="0.40" PowerHigh="0.75">
            <textevent timeoffset="5" duration="15" message="Warm up at your normal cadence. No low cadence until the first interval." />
            <textevent timeoffset="30" duration="30" message="This session is EVOQ's TorqueMax (Landry Bobo): 'around 2-3 minutes at 105-110% of FTP and around 50-60 rpm', 'starting with six repetitions and working up to eight'." />
            <textevent timeoffset="75" duration="20" message="All the research behind this program: high-torque.jelen.dk" />
            <textevent timeoffset="120" duration="30" message="EVOQ warns: 'There is an increased risk of injury with these intervals.' Do the lower-intensity torque intervals before this one." />
            <textevent timeoffset="270" duration="30" message="No study has tested TorqueMax itself. It's EVOQ's coaching practice, built on the 2024 Hebisz study." />
            <textevent timeoffset="420" duration="25" message="Today: 2.5-minute reps at 110%, the top of EVOQ's range, with 4 minutes easy between them." />
            <textevent timeoffset="540" duration="30" message="Coach Neal Henderson on big-gear sessions in general: 'Generally I do about one of these sessions a week at most two', because they are 'a bit more stressful from a muscular skeletal standpoint'." />
            <textevent timeoffset="660" duration="30" message="Stay seated for every interval. Coach Neal Henderson's reason: seated riding puts less compression on your joints." />
            <textevent timeoffset="750" duration="20" message="If your knees ache at any point during an interval, stop the interval. Don't push through knee discomfort." />
            <textevent timeoffset="840" duration="20" message="Six intervals of 2.5 minutes, 4 minutes easy between. Two short openers first." />
        </Warmup>

        <SteadyState Duration="30" Power="1.10">
            <textevent timeoffset="0" message="Opener 1. Normal cadence." />
        </SteadyState>
        <SteadyState Duration="120" Power="0.55">
            <textevent timeoffset="0" message="Easy spin. Opener 2 coming." />
        </SteadyState>
        <SteadyState Duration="30" Power="1.10">
            <textevent timeoffset="0" message="Opener 2." />
        </SteadyState>
        <SteadyState Duration="120" Power="0.55">
            <textevent timeoffset="10" duration="20" message="In ERG mode, just drop to 50-60 rpm when the interval starts. The trainer raises the resistance to hold 110% FTP." />
            <textevent timeoffset="60" duration="20" message="First interval in 60 seconds. STAY SEATED. 50-60 rpm. 105-110% FTP. 2.5 minutes." />
        </SteadyState>

        <SteadyState Duration="150" Power="1.10" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. 50-60 rpm. 105-110% FTP. GO." />
            <textevent timeoffset="20" message="Hold 50-60 rpm." />
            <textevent timeoffset="75" message="Halfway. First of six." />
            <textevent timeoffset="120" message="30 seconds. Do not stand. Do not spin up." />
            <textevent timeoffset="145" message="5 seconds." />
        </SteadyState>

        <SteadyState Duration="240" Power="0.50">
            <textevent timeoffset="2" message="Recovery. 4 minutes. Easy spin." />
            <textevent timeoffset="40" duration="25" message="Tip: if you can't hold the power at this cadence, lower the workout intensity a few percent rather than grinding." />
            <textevent timeoffset="180" message="Next interval. Settle to 50-60 rpm. Seated." />
        </SteadyState>

        <SteadyState Duration="150" Power="1.10" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. 50-60 rpm. 105-110% FTP. GO." />
            <textevent timeoffset="20" message="Hold 50-60 rpm." />
            <textevent timeoffset="75" message="Halfway." />
            <textevent timeoffset="120" message="30 seconds. Do not stand. Do not spin up." />
            <textevent timeoffset="145" message="5 seconds." />
        </SteadyState>

        <SteadyState Duration="240" Power="0.50">
            <textevent timeoffset="2" message="Recovery. 4 minutes." />
            <textevent timeoffset="60" message="Knee check. Anything beyond muscle burn?" />
            <textevent timeoffset="180" message="Next interval. 50-60 rpm. Seated." />
        </SteadyState>

        <SteadyState Duration="150" Power="1.10" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. 50-60 rpm. 105-110% FTP. GO." />
            <textevent timeoffset="20" message="Hold 50-60 rpm." />
            <textevent timeoffset="75" message="Halfway. Three of six done after this." />
            <textevent timeoffset="120" message="30 seconds. Do not stand." />
            <textevent timeoffset="145" message="5 seconds." />
        </SteadyState>

        <SteadyState Duration="240" Power="0.50">
            <textevent timeoffset="2" message="Recovery." />
            <textevent timeoffset="60" duration="25" message="At 250 W FTP, 110% at 55 rpm is about 48 Nm of torque on each pedal stroke. Short reps, high force." />
            <textevent timeoffset="180" message="Next interval. 50-60 rpm. Seated." />
        </SteadyState>

        <SteadyState Duration="150" Power="1.10" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. 50-60 rpm. 105-110% FTP. GO." />
            <textevent timeoffset="20" message="Hold 50-60 rpm." />
            <textevent timeoffset="75" message="Halfway. Four of six done after this." />
            <textevent timeoffset="120" message="30 seconds. Do not stand." />
            <textevent timeoffset="145" message="5 seconds." />
        </SteadyState>

        <SteadyState Duration="240" Power="0.50">
            <textevent timeoffset="2" message="Recovery." />
            <textevent timeoffset="180" message="Next interval. 50-60 rpm. Seated." />
        </SteadyState>

        <SteadyState Duration="150" Power="1.10" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. 50-60 rpm. 105-110% FTP. GO." />
            <textevent timeoffset="20" message="Hold 50-60 rpm." />
            <textevent timeoffset="75" message="Halfway. One more after this." />
            <textevent timeoffset="120" message="30 seconds. Do not stand." />
            <textevent timeoffset="145" message="5 seconds." />
        </SteadyState>

        <SteadyState Duration="240" Power="0.50">
            <textevent timeoffset="2" message="Recovery." />
            <textevent timeoffset="60" duration="20" message="Five down, one to go. If your knees are aching, skip the final interval." />
            <textevent timeoffset="180" message="Final interval. 50-60 rpm. Seated." />
        </SteadyState>

        <SteadyState Duration="150" Power="1.10" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. 50-60 rpm. 105-110% FTP. GO. Final interval." />
            <textevent timeoffset="20" message="Hold 50-60 rpm. Last effort." />
            <textevent timeoffset="75" message="Halfway. Almost done." />
            <textevent timeoffset="120" message="30 seconds. Do not stand. Finish it." />
            <textevent timeoffset="145" message="5 seconds." />
        </SteadyState>

        <Cooldown Duration="900" PowerLow="0.50" PowerHigh="0.40">
            <textevent timeoffset="10" message="TorqueMax complete. Six intervals done. Spin easy at normal cadence." />
            <textevent timeoffset="150" duration="25" message="Six reps is EVOQ's starting point; they work up to eight. This workout stays at six." />
            <textevent timeoffset="360" duration="25" message="Note how your knees feel. Any ache? If it keeps coming back, stop torque work and see a professional." />
            <textevent timeoffset="600" duration="25" message="Leave at least a full day before your next torque session. No back-to-back days." />
        </Cooldown>
    </workout>
</workout_file>
