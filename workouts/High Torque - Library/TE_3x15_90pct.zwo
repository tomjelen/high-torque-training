<workout_file>
    <author>Tom Jelen</author>
    <name>Torque Endurance 3x15</name>
    <activitySaveName>High Torque: Torque Endurance 3x15 min 90% FTP @ 50-60 rpm</activitySaveName>
    <description>Torque Endurance 3×15: three 15-minute intervals at 90% FTP and 50–60 rpm, with 15 minutes of easy spin between them. Seated throughout. Source: EVOQ / Brendan Housler, the later step of his ladder (EVOQ.BIKE blog, 2020): "Eventually move to 50-60rpm, and extend out to 3 x 15m. Aim for 90-105% FTP." The file holds 90%, the floor of Housler's 90–105% (our choice). 45 min of work is above CTS's ~40 min for advanced riders, and the 15-minute reps are longer than CTS's 5–10 min. Housler gives no recovery; resting as long as the rep is our choice, as John Wakefield and CTS (Jim Rutberg) use. The name "Torque Endurance" is the one used on the EVOQ podcast (auto-captions).</description>
    <sportType>bike</sportType>
    <tags />
    <workout>
        <Warmup Duration="900" PowerLow="0.40" PowerHigh="0.75">
            <textevent timeoffset="5" duration="15" message="Warm up at your normal cadence. No low cadence until the first interval." />
            <textevent timeoffset="30" duration="30" message="Source: EVOQ / Brendan Housler (EVOQ.BIKE blog): 'Eventually move to 50-60rpm, and extend out to 3 x 15m. Aim for 90-105% FTP.'" />
            <textevent timeoffset="75" duration="20" message="All the research behind this program: high-torque.jelen.dk" />
            <textevent timeoffset="120" duration="25" message="The file holds 90% FTP, the floor of Housler's 90-105% range. That is our choice: these are long reps." />
            <textevent timeoffset="240" duration="30" message="45 minutes of work. That is above CTS's ~40 min for advanced riders, and 15-minute reps are longer than CTS's 5-10 min. A big session." />
            <textevent timeoffset="360" duration="25" message="Housler gives no recovery. 15 minutes, as long as the rep, is our choice, as John Wakefield and CTS (Jim Rutberg) use." />
            <textevent timeoffset="480" duration="25" message="All intervals are SEATED. Standing lets you use body weight on the pedals, bypassing the forced muscular contraction that makes this training work." />
            <textevent timeoffset="600" duration="25" message="Target cadence: 50-60 rpm. In ERG mode, just drop to this cadence. The trainer raises the resistance to hold 90% FTP." />
            <textevent timeoffset="720" duration="20" message="If your knees ache at any point during an interval, stop the interval. Don't push through knee discomfort." />
            <textevent timeoffset="820" duration="20" message="Fifteen minutes is a long time at 50-60 rpm. Settle in early and keep it steady." />
        </Warmup>

        <SteadyState Duration="900" Power="0.90" Cadence="55">
            <textevent timeoffset="10" message="Interval 1. 90% FTP, 50-60 rpm. STAY SEATED." />
            <textevent timeoffset="300" message="5 minutes in. Hold the cadence." />
            <textevent timeoffset="450" message="Halfway. Smooth pedal strokes." />
            <textevent timeoffset="600" message="5 minutes left. Stay seated." />
            <textevent timeoffset="870" message="30 seconds left in this interval." />
        </SteadyState>

        <SteadyState Duration="900" Power="0.50">
            <textevent timeoffset="10" duration="20" message="Recovery: 15 minutes, as long as the rep. Easy spin at any cadence." />
            <textevent timeoffset="90" duration="25" message="If your cadence sags below target, lower the workout intensity (FTP bias) rather than grinding." />
            <textevent timeoffset="300" duration="30" message="Neal Henderson calls long big-gear efforts 'truly a muscular endurance type of thing' (Fast Talk ep. 125, 2020, machine transcript; speaker inferred from context)." />
            <textevent timeoffset="600" message="Knees still feeling fine?" />
            <textevent timeoffset="840" message="Next interval in 1 minute. Seated." />
        </SteadyState>

        <SteadyState Duration="900" Power="0.90" Cadence="55">
            <textevent timeoffset="10" message="Interval 2. 90% FTP, 50-60 rpm. STAY SEATED." />
            <textevent timeoffset="300" message="5 minutes in. Hold the cadence." />
            <textevent timeoffset="450" message="Halfway. Heavy legs are normal." />
            <textevent timeoffset="600" message="5 minutes left. Stay seated." />
            <textevent timeoffset="870" message="30 seconds left in this interval." />
        </SteadyState>

        <SteadyState Duration="900" Power="0.50">
            <textevent timeoffset="10" message="Recovery. Two down, one to go." />
            <textevent timeoffset="120" duration="30" message="At 250 W FTP, 90% at 55 rpm is about 39 Nm per pedal stroke, held for 45 minutes in total (our arithmetic)." />
            <textevent timeoffset="600" duration="20" message="If your knees are aching, skip the final interval. Protecting the joints is always the right call on torque work." />
            <textevent timeoffset="840" message="Final interval in 1 minute. Seated." />
        </SteadyState>

        <SteadyState Duration="900" Power="0.90" Cadence="55">
            <textevent timeoffset="10" message="Final interval. 90% FTP, 50-60 rpm. STAY SEATED." />
            <textevent timeoffset="300" message="5 minutes in. Hold the cadence." />
            <textevent timeoffset="450" duration="15" message="Halfway. Last effort. Keep it steady." />
            <textevent timeoffset="600" message="5 minutes left. Stay seated." />
            <textevent timeoffset="870" message="30 seconds. Finish it." />
        </SteadyState>

        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.40">
            <textevent timeoffset="30" message="Cool down. Spin easy at normal cadence." />
            <textevent timeoffset="120" duration="20" message="Note how your knees feel. Any ache or tightness? If yes, skip the next torque session and monitor." />
            <textevent timeoffset="270" duration="25" message="The name 'Torque Endurance' is the one used on the EVOQ podcast (auto-captions) for these long low-cadence intervals." />
            <textevent timeoffset="420" duration="25" message="Our rule: no torque sessions on back-to-back days. CTS coach Jim Rutberg says beginner and intermediate riders should separate them by at least a full day." />
        </Cooldown>
    </workout>
</workout_file>
