<?xml version="1.0" encoding="UTF-8"?>
<!--
  High Torque Training — Zwift workout
  Last updated: 2026-11-11

  Site:      https://high-torque.jelen.dk/
  Calendar:  https://high-torque.jelen.dk/content/workouts.md
  Rationale: https://high-torque.jelen.dk/content/rationale.md
  LLMs:      https://high-torque.jelen.dk/llms.txt
-->
<workout_file>
    <author>Tom Jelen</author>
    <name>SIT (3 sets)</name>
    <activitySaveName>High Torque: SIT (3 sets) 4x30s sprint @ 50-60 rpm</activitySaveName>
    <description>Volume progression of the Hebisz &amp; Hebisz (2024) SIT protocol. Three sets of 4 x 30-second maximal sprints at 50-60 rpm, with 90 seconds of active rest between sprints and 25 minutes between sets. 12 total sprints. The study set both rests 'similar to the power at VT1' (90 s) and 'also at low intensity' (25 min); ~65% FTP for both is my estimate and choice. The sprints have no power target: you set the force. Seated throughout. The study riders were 17–20-year-old women with at least 3 years' training (10+ hours a week), and had done 3 months of base work, including core work, running with jumping exercises and lower-limb strength training, before day one.</description>
    <sportType>bike</sportType>
    <tags />
    <workout>
        <Warmup Duration="1200" PowerLow="0.40" PowerHigh="0.75">
            <textevent timeoffset="5" duration="15" message="Warm up at your normal cadence. No low cadence until the first sprint." />
            <textevent timeoffset="30" duration="25" message="This session comes from a 2024 study by Hebisz and Hebisz: 12x30s all-out at 50-60 rpm, in 3 sets of 4. The study's second four weeks, up from 8 sprints." />
            <textevent timeoffset="75" duration="20" message="All the research behind this program: high-torque.jelen.dk" />
            <textevent timeoffset="270" duration="25" message="Same rules: 50-60 rpm, maximal effort, 90 seconds of active rest between reps, 25 minutes between sets. The sprints have no power target; ERG switches off for each sprint block." />
            <textevent timeoffset="420" duration="30" message="Twelve 30-second sprints at 50-60 rpm is a lot more work than eight. If the 2-set version left your knees sore, do that one instead. If knee pain keeps coming back, stop torque work and see a professional." />
            <textevent timeoffset="570" duration="30" message="Stay seated for every sprint, every second. Coach Neal Henderson's reason: seated riding puts less compression on your joints." />
            <textevent timeoffset="720" duration="25" message="KNEE WARNING: If your knees ache during a sprint, stop the sprint. Don't push through knee discomfort. If your knees are not 100% today, skip this session." />
            <textevent timeoffset="900" duration="20" message="Sprints are short: 30 seconds. Rests are 90 seconds. The 25-minute break between sets is part of the study design. The paper gives no reason for its length." />
            <textevent timeoffset="1050" duration="15" message="Three sets. Pace yourself mentally. The third set will be the hardest." />
            <textevent timeoffset="1140" duration="20" message="First sprint in 1 minute. Find your gear. Hard gear. 50-60 rpm. Maximal effort." />
        </Warmup>

        <!-- Set 1 -->
        <!-- The FreeRide blocks below ARE max-effort sprints. They use FreeRide, not
             MaxEffort, because MaxEffort deadlocks with ERG (the "spiral of death");
             FreeRide auto-releases ERG for the sprint and restores it after. The chart
             parser maps FreeRide -> zone-6 max sprint, so they still render as max
             efforts. Do not convert these back to MaxEffort. -->
        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Set 1. Maximal effort. 50-60 rpm." />
            <textevent timeoffset="15" message="Halfway. Keep driving. Seated." />
            <textevent timeoffset="28" message="2 seconds. Do not stand." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Active rest. 90 seconds at ~65% FTP." />
            <textevent timeoffset="30" message="Stay loose. Let the legs recover." />
            <textevent timeoffset="70" message="Find your gear for the next sprint." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Maximal." />
            <textevent timeoffset="15" message="Halfway. Seated." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Recover. Easy spin." />
            <textevent timeoffset="30" message="Good. Stay loose." />
            <textevent timeoffset="70" message="Next sprint coming." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Maximal." />
            <textevent timeoffset="15" message="Halfway. Seated." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Recover." />
            <textevent timeoffset="30" message="Three down in this set." />
            <textevent timeoffset="70" message="Last sprint of set 1. Find your gear." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Last sprint of set 1." />
            <textevent timeoffset="15" message="Halfway. Drive it." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="1500" Power="0.65">
            <textevent timeoffset="10" message="Set 1 complete. 25 minutes of active rest now." />
            <textevent timeoffset="120" duration="30" message="Keep it easy, around 65% FTP, the same as the short rests." />
            <textevent timeoffset="600" message="10 minutes into rest. Knees okay after the first set?" />
            <textevent timeoffset="900" duration="30" message="The study riders did SIT from day one, but after at least 3 years of training and 3 months of base work that included strength and jumping exercises." />
            <textevent timeoffset="1380" duration="20" message="2 minutes to set 2. Find your gear. Same hard gear. 50-60 rpm." />
            <textevent timeoffset="1470" message="30 seconds. Get ready. Seated. Maximal." />
        </SteadyState>

        <!-- Set 2 -->
        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Set 2. Maximal." />
            <textevent timeoffset="15" message="Halfway. Drive it. Seated." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Active rest. 90 seconds at ~65% FTP." />
            <textevent timeoffset="30" message="Good. Hold the quality." />
            <textevent timeoffset="70" message="Next sprint coming. Stay focused." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Maximal." />
            <textevent timeoffset="15" message="Halfway. Seated." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Recover." />
            <textevent timeoffset="30" message="Good. Stay in the gear." />
            <textevent timeoffset="70" message="Next sprint." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Maximal." />
            <textevent timeoffset="15" message="Halfway. Seated." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Recover." />
            <textevent timeoffset="30" message="Three down in set 2." />
            <textevent timeoffset="70" message="Last sprint of set 2. Find your gear." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Last sprint of set 2." />
            <textevent timeoffset="15" message="Halfway. Drive it." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="1500" Power="0.65">
            <textevent timeoffset="10" message="Set 2 complete. 25 minutes active rest before the final set." />
            <textevent timeoffset="120" duration="25" message="Two sets done. The third set is what the study added in weeks 5-8." />
            <textevent timeoffset="600" message="10 minutes. Knee check. Anything joint-related, not muscle burn?" />
            <textevent timeoffset="900" duration="20" message="15 minutes into the rest. If anything feels wrong in the knees, skip set 3. Eight sprints is still a good session." />
            <textevent timeoffset="1380" message="2 minutes to set 3. Last set. Find your gear." />
            <textevent timeoffset="1470" message="30 seconds. Everything you have left. Seated. Maximal." />
        </SteadyState>

        <!-- Set 3 -->
        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Final set. Maximal effort." />
            <textevent timeoffset="15" message="Halfway. Do not let up. Seated." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Recover. Easy spin." />
            <textevent timeoffset="30" message="Good. Stay in the gear." />
            <textevent timeoffset="70" message="Next sprint coming." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Maximal." />
            <textevent timeoffset="15" message="Halfway. Seated." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Recover." />
            <textevent timeoffset="70" message="Next sprint." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Maximal." />
            <textevent timeoffset="15" message="Halfway. Seated." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>
        <SteadyState Duration="90" Power="0.65">
            <textevent timeoffset="2" message="Recover. Almost done." />
            <textevent timeoffset="70" message="Last sprint. Leave nothing." />
        </SteadyState>

        <FreeRide Duration="30" FlatRoad="1" Cadence="55">
            <textevent timeoffset="0" message="STAY SEATED. GO. Final sprint." />
            <textevent timeoffset="15" message="Halfway. Last effort." />
            <textevent timeoffset="28" message="2 seconds." />
        </FreeRide>

        <Cooldown Duration="900" PowerLow="0.50" PowerHigh="0.40">
            <textevent timeoffset="10" message="12 sprints done. Full study volume achieved." />
            <textevent timeoffset="300" duration="25" message="Note how your knees feel. Any ache? If it keeps coming back, stop torque work and see a professional." />
            <textevent timeoffset="480" duration="25" message="Leave at least a full day before your next torque session. No back-to-back days." />
            <textevent timeoffset="840" duration="30" message="One small study: well-trained women aged 17-20, 12 per group. The paper reports no knee or injury monitoring. Promising, not proven." />
        </Cooldown>
    </workout>
</workout_file>
