<workout_file>
    <author>Tom Jelen</author>
    <name>Torque Endurance 4x8</name>
    <activitySaveName>High Torque: Torque Endurance 4x8 min 95% FTP @ 60-70 rpm</activitySaveName>
    <description>Torque Endurance 4×8: four 8-minute intervals at 95% FTP and 60–70 rpm, with 8 minutes of easy spin between them. Seated throughout. Source: EVOQ / Brendan Housler, unscaled. Housler's written start (EVOQ.BIKE blog, 2020): "Start off with 4 x 8m @ 95% at 60-70rpm." 32 min of work, a step up from TE 3×8's 24 min. Housler gives no recovery; resting as long as the rep is my choice, as John Wakefield and CTS (Jim Rutberg) use. The name "Torque Endurance" is the one used on the EVOQ podcast (auto-captions).</description>
    <sportType>bike</sportType>
    <tags />
    <workout>
        <Warmup Duration="900" PowerLow="0.40" PowerHigh="0.75">
            <textevent timeoffset="5" duration="15" message="Warm up at your normal cadence. No low cadence until the first interval." />
            <textevent timeoffset="30" duration="30" message="This session comes from coach Brendan Housler at EVOQ: 'Start off with 4 x 8m @ 95% at 60-70rpm.' This is his full version." />
            <textevent timeoffset="75" duration="20" message="Want to go deeper on the science? high-torque.jelen.dk/rationale" />
            <textevent timeoffset="120" duration="25" message="32 minutes of work at 95%. Torque Endurance 3x8 has one rep fewer (24 min); this is the next step up." />
            <textevent timeoffset="240" duration="25" message="Recovery is as long as the rep: 8 minutes. Coach John Wakefield and CTS's Jim Rutberg rest the same way." />
            <textevent timeoffset="420" duration="30" message="Stay seated for every interval. Coach Neal Henderson's reason: seated riding puts less compression on your joints." />
            <textevent timeoffset="600" duration="25" message="Target cadence: 60-70 rpm. In ERG mode, just drop to this cadence. The trainer raises the resistance to hold 95% FTP." />
            <textevent timeoffset="720" duration="20" message="If your knees ache at any point during an interval, stop the interval. Don't push through knee discomfort." />
            <textevent timeoffset="820" duration="20" message="Four reps of 8 minutes. Settle into a steady rhythm from the start." />
        </Warmup>

        <SteadyState Duration="480" Power="0.95" Cadence="65">
            <textevent timeoffset="10" message="Interval 1. 95% FTP, 60-70 rpm. STAY SEATED." />
            <textevent timeoffset="240" message="Halfway. Hold the power. Breathe." />
            <textevent timeoffset="450" message="30 seconds left in this interval." />
        </SteadyState>

        <SteadyState Duration="480" Power="0.50">
            <textevent timeoffset="10" duration="20" message="Recovery: 8 minutes, as long as the rep. Easy spin at any cadence." />
            <textevent timeoffset="60" duration="25" message="Tip: if you can't hold the power at this cadence, lower the workout intensity a few percent rather than grinding." />
            <textevent timeoffset="180" duration="30" message="Where this leads, in Housler's words: 'Eventually move to 50-60rpm, and extend out to 3 x 15m. Aim for 90-105% FTP.'" />
            <textevent timeoffset="420" message="Next interval in 1 minute. Seated." />
        </SteadyState>

        <SteadyState Duration="480" Power="0.95" Cadence="65">
            <textevent timeoffset="10" message="Interval 2. 95% FTP, 60-70 rpm. STAY SEATED." />
            <textevent timeoffset="240" message="Halfway. Smooth pedal strokes." />
            <textevent timeoffset="450" message="30 seconds left in this interval." />
        </SteadyState>

        <SteadyState Duration="480" Power="0.50">
            <textevent timeoffset="10" message="Recovery. Halfway through the set." />
            <textevent timeoffset="60" duration="30" message="On the Fast Talk podcast, long big-gear efforts are called 'truly a muscular endurance type of thing'." />
            <textevent timeoffset="300" message="Knees still feeling fine?" />
            <textevent timeoffset="420" message="Next interval in 1 minute. Seated." />
        </SteadyState>

        <SteadyState Duration="480" Power="0.95" Cadence="65">
            <textevent timeoffset="10" message="Interval 3. 95% FTP, 60-70 rpm. STAY SEATED." />
            <textevent timeoffset="240" message="Halfway. Heavy legs are normal." />
            <textevent timeoffset="450" message="30 seconds left in this interval." />
        </SteadyState>

        <SteadyState Duration="480" Power="0.50">
            <textevent timeoffset="10" message="Recovery. Three down, one to go." />
            <textevent timeoffset="300" duration="20" message="If your knees are aching, skip the final interval. Protecting the joints is always the right call on torque work." />
            <textevent timeoffset="420" message="Final interval in 1 minute. Seated." />
        </SteadyState>

        <SteadyState Duration="480" Power="0.95" Cadence="65">
            <textevent timeoffset="10" message="Final interval. 95% FTP, 60-70 rpm. STAY SEATED." />
            <textevent timeoffset="240" duration="15" message="Halfway. Last effort. Keep it steady." />
            <textevent timeoffset="450" message="30 seconds. Finish it." />
        </SteadyState>

        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.40">
            <textevent timeoffset="30" message="Cool down. Spin easy at normal cadence." />
            <textevent timeoffset="120" duration="25" message="Note how your knees feel. Any ache? If it keeps coming back, stop torque work and see a professional." />
            <textevent timeoffset="270" duration="25" message="The name 'Torque Endurance' comes from the EVOQ podcast, for these long low-cadence intervals." />
            <textevent timeoffset="420" duration="25" message="Leave at least a full day before your next torque session. No back-to-back days." />
        </Cooldown>
    </workout>
</workout_file>
